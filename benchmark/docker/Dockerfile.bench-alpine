# =============================================================================
# Dockerfile.bench-alpine  —  Tier 1 benchmark image (musl, Alpine 3.19).
#
# musl counterpart of Dockerfile.bench-glibc, used by
# `benchmark/run-bench.sh --libc=alpine` (or --libc=musl). Same model: toolchain
# only, repository bind-mounted at /work, every run tagged ADVISORY.
#
# Differences from the glibc image:
#  - gcc here is a native musl compiler. Thread and clock functions live in
#    libc.musl itself; the harness's -lrt and -lpthread resolve to musl's
#    empty stub archives.
#  - musl's resolver has no NSS layer, so getaddrinfo/getnameinfo baselines
#    differ from glibc's.
#  - linux-headers supplies <linux/perf_event.h> for the harness PMU code;
#    build-base does not include it.
# =============================================================================

FROM alpine:3.19

RUN apk add --no-cache \
        build-base \
        gcc \
        make \
        ca-certificates \
        git \
        python3 \
        bash \
        linux-headers

WORKDIR /work

CMD ["make", "-f", "benchmark/Makefile.bench", "bench-list"]
