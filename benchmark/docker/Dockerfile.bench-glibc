# =============================================================================
# Dockerfile.bench-glibc  —  Tier 1 benchmark image (glibc, Debian 12).
#
# Toolchain-only image for `benchmark/run-bench.sh` (default, or --libc=glibc).
# The script builds it from the benchmark/docker context, bind-mounts the
# repository at /work and builds the libchaos libraries and the harness inside
# the container, so the image has no source and needs no rebuild when code
# changes. python3 is present for the comparison driver.
#
# Every run in this image is tagged ADVISORY by the harness: /.dockerenv exists,
# and the container cannot control what OFFICIAL requires:
#   - CPU placement: run-bench.sh restricts the container to CPUs 0 and 1 with
#     --cpuset-cpus, but does not isolate them from host tasks or IRQs.
#   - cpufreq governor and SMT are host settings.
# OFFICIAL numbers need a Tier 2 host (isolcpus, nohz_full, performance
# governor, steered IRQs); see benchmark/README.md.
# =============================================================================

FROM debian:12-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        build-essential \
        gcc \
        make \
        ca-certificates \
        git \
        python3 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /work

# No COPY: run-bench.sh bind-mounts the repository here.

# Without arguments: build the harness and list every registered benchmark.
# Useful as a toolchain smoke test; run-bench.sh always overrides the command.
CMD ["make", "-f", "benchmark/Makefile.bench", "bench-list"]
