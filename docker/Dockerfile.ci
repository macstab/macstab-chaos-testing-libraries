# =============================================================================
# docker/Dockerfile.ci — local CI gate image.
#
# Same base (ubuntu:24.04) and toolchain as the jobs of .github/workflows/ci.yml, so that a
# macOS or Windows host can run the CI correctness gate locally before pushing. Used by the
# ci-local* targets of the Makefile, which bind-mount the repository at /work.
#
# Covers fmt-check, unit, coverage, ASan, UBSan and scan-build. It does not run the runtime
# suites. Not for benchmarks: on Apple Silicon or Windows hosts this container runs in a VM
# (HVF/qemu) whose virtual counter ticks at ~24 MHz instead of a GHz-class invariant TSC, so
# cycle-based timings are meaningless. Use the bench.yml workflow on a Linux runner.
# =============================================================================

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# clang-format: fmt-check. clang-tools: scan-build. gcc: unit, coverage and sanitizer builds.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        gcc \
        clang \
        clang-format \
        clang-tools \
        make \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work
