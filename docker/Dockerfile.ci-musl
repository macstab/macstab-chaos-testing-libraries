# =============================================================================
# docker/Dockerfile.ci-musl — local CI gate image, musl/Alpine variant.
#
# Sibling of Dockerfile.ci (glibc/Ubuntu) for compiling and running the unit tests and the
# coverage gate against musl headers. musl defines a different subset of CLOCK_*, CAP_* and
# other preprocessor symbols, so code compiled, and coverage measured, on glibc alone says
# nothing about the #if branches taken on Alpine.
# No Makefile target or workflow references this image; build and run it by hand, e.g.
#   docker build -t chaos-ci-musl -f docker/Dockerfile.ci-musl docker
#   docker run --rm -v "$PWD":/work chaos-ci-musl make unit BUILD_DIR=build-musl
# =============================================================================

FROM alpine:3.19

RUN apk add --no-cache \
        build-base \
        gcc \
        make \
        bash \
        ca-certificates

WORKDIR /work
